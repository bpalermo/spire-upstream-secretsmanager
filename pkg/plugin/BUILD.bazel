load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plugin",
    srcs = [
        "aws.go",
        "config.go",
        "plugin.go",
    ],
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/pkg/plugin",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/cache",
        "//pkg/secret",
        "//pkg/upstreamca",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_config//:config",
        "@com_github_aws_aws_sdk_go_v2_credentials//stscreds",
        "@com_github_aws_aws_sdk_go_v2_service_secretsmanager//:secretsmanager",
        "@com_github_aws_aws_sdk_go_v2_service_sts//:sts",
        "@com_github_hashicorp_go_hclog//:go-hclog",
        "@com_github_hashicorp_hcl//:hcl",
        "@com_github_spiffe_go_spiffe_v2//spiffeid",
        "@com_github_spiffe_spire_plugin_sdk//proto/spire/plugin/server/upstreamauthority/v1:upstreamauthority",
        "@com_github_spiffe_spire_plugin_sdk//proto/spire/plugin/types",
        "@com_github_spiffe_spire_plugin_sdk//proto/spire/service/common/config/v1:config",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
