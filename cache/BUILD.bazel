    name = "cache",
    srcs = ["cache.go"],
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/cache",
    visibility = ["//visibility:public"],
    deps = [
        "//cache/v1:cache",
        "//intermediateca",
        "//secret",
