        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_secretsmanager//:secretsmanager",
        "@com_github_hashicorp_go_hclog//:go-hclog",
        "@com_github_spiffe_spire_plugin_sdk//pluginsdk",
        "@com_github_spiffe_spire_plugin_sdk//plugintest",
        "@com_github_spiffe_spire_plugin_sdk//proto/spire/plugin/server/upstreamauthority/v1:upstreamauthority",
        "@com_github_spiffe_spire_plugin_sdk//proto/spire/service/common/config/v1:config",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
