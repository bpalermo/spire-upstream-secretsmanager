load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_buf//buf:defs.bzl", "buf_lint_test")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# The plugin's cache file schema. Gazelle generates the proto_library and the
# go_proto_library; the generated Go is not committed.

proto_library(
    name = "cachev1_proto",
    srcs = ["cache.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//intermediateca/v1:intermediatecav1_proto",
        "@protovalidate//proto/protovalidate/buf/validate:validate_proto",
    ],
)

go_proto_library(
    name = "cachev1_go_proto",
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/cache/v1",
    proto = ":cachev1_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//intermediateca/v1:intermediateca",
        "@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate",
    ],
)

go_library(
    name = "cache",
    embed = [":cachev1_go_proto"],
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/cache/v1",
    visibility = ["//visibility:public"],
)

# The STANDARD and COMMENTS rules of //:buf.yaml.
buf_lint_test(
    name = "cachev1_proto_lint_test",
    size = "small",
    config = "//:buf.yaml",
    targets = [":cachev1_proto"],
)
