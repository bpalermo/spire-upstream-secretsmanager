load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_buf//buf:defs.bzl", "buf_lint_test")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

# The schema of the plugin's plugin_data. Gazelle generates the proto_library and the
# go_proto_library; the generated Go is not committed.

proto_library(
    name = "pluginv1_proto",
    srcs = ["config.proto"],
    visibility = ["//visibility:public"],
    deps = ["@protovalidate//proto/protovalidate/buf/validate:validate_proto"],
)

go_proto_library(
    name = "pluginv1_go_proto",
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/plugin/v1",
    proto = ":pluginv1_proto",
    visibility = ["//visibility:public"],
    deps = ["@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate"],
)

go_library(
    name = "plugin",
    embed = [":pluginv1_go_proto"],
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/plugin/v1",
    visibility = ["//visibility:public"],
)

# The STANDARD and COMMENTS rules of //:buf.yaml.
buf_lint_test(
    name = "pluginv1_proto_lint_test",
    size = "small",
    config = "//:buf.yaml",
    targets = [":pluginv1_proto"],
)
