load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "config",
    srcs = ["config.go"],
    importpath = "github.com/bpalermo/spire-upstream-secretsmanager/config",
    visibility = ["//visibility:public"],
    deps = [
        "//config/v1:config",
        "//intermediate",
        "@build_buf_go_protovalidate//:protovalidate",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
        "@org_golang_google_protobuf//encoding/protojson",
    ],
)

go_test(
    name = "config_test",
    srcs = ["config_test.go"],
    data = ["//:README.md"],
    deps = [
        ":config",
        "//intermediate",
        "//internal/testpki",
        "@com_github_aws_aws_sdk_go_v2//aws",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//:ssm",
        "@com_github_aws_aws_sdk_go_v2_service_ssm//types",
    ],
)
