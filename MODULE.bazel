module(
    name = "spire_upstream_secretsmanager",
    version = "0.0.0",
)

bazel_dep(name = "rules_go", version = "0.64.2")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_img", version = "0.3.23")

# pkg_zip, for the rotator's release archives (//rotator:zip_<platform>).
# Older versions use the removed incompatible_use_toolchain_transition
# keyword.
bazel_dep(name = "rules_pkg", version = "1.3.0")

# Named by //bazel/image for string_flag, and already in the graph through
# rules_img and rules_go; declared so a bump of those cannot drop it.
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# sh_library, sh_binary and sh_test for the scripts under //bazel, the tool
# wrappers in //bazel/cosign and the generators of //bazel/proto.
bazel_dep(name = "rules_shell", version = "0.8.0")

# The cosign CLI -- only the CLI. @rules_img_signer_cosign//cosign is the
# official prebuilt release binary, selected per platform, with its sha256
# pinned in the module's own lock. //bazel/cosign wraps it so the release
# workflow and a workstation run the same checksummed cosign; bumping cosign
# is bumping this bazel_dep (and EXPECTED in //bazel/cosign:version_test).
bazel_dep(name = "rules_img_signer_cosign", version = "0.0.1")

# proto_library, and protoc to compile the protos for the generators.
bazel_dep(name = "protobuf", version = "36.2")

# The protovalidate annotations (buf/validate/validate.proto) the schemas are
# written with. The Go runtime that enforces them is the Go module
# buf.build/go/protovalidate (go.mod).
bazel_dep(name = "protovalidate", version = "1.2.2")

# protovalidate asks for an older googleapis, whose dependencies (an old
# rules_foreign_cc) do not load with this Bazel; a newer one does.
bazel_dep(name = "googleapis", version = "0.0.0-20260929-28769825")

# buf lints the protos (the *_proto_lint_test targets), checks them for
# breaking changes (bazel/proto/breaking.sh) and formats them. Only its
# checks are used: protoc compiles, and rules_go generates.
bazel_dep(name = "rules_buf", version = "0.5.4")

# Formatting and the linters that are not part of compiling: //bazel/format
# formats and checks Starlark (buildifier, with its lint warnings), Go, shell
# and protos; //bazel/lint has the shellcheck and gocognit aspects.
bazel_dep(name = "aspect_rules_lint", version = "2.9.1")
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(
    sha256 = "18f603d3b418f6a1259da4425b04bbe2fbaf60c2b796b98114d961e8736198b9",
    version = "v1.73.0",
)
use_repo(buf, "rules_buf_toolchains")

# The Go toolchain, from go.mod's `go` line.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# Static analysis, run as part of compiling every Go package of this module
# (and of none of its dependencies): a finding fails the build. //:nogo says
# which analyzers.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# The SPIRE plugin SDK checks in its generated Go next to the .proto sources;
# with proto generation on, Gazelle would make go_proto_library targets for
# them that do not resolve. Use the checked-in .pb.go instead.
go_deps.gazelle_override(
    build_file_generation = "clean",
    directives = ["gazelle:proto disable_global"],
    path = "github.com/spiffe/spire-plugin-sdk",
)

# cel-go (protovalidate's expression engine) ships BUILD files that name every
# library go_default_library, which is not what Gazelle names a dependency's
# libraries here (//ext:ext); generate them again.
go_deps.gazelle_override(
    build_file_generation = "clean",
    path = "cel.dev/cel-go",
)
use_repo(go_deps, "build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go", "build_buf_go_protovalidate", "co_honnef_go_tools", "com_github_aws_aws_lambda_go", "com_github_aws_aws_sdk_go_v2", "com_github_aws_aws_sdk_go_v2_config", "com_github_aws_aws_sdk_go_v2_credentials", "com_github_aws_aws_sdk_go_v2_service_kms", "com_github_aws_aws_sdk_go_v2_service_secretsmanager", "com_github_aws_aws_sdk_go_v2_service_ssm", "com_github_aws_aws_sdk_go_v2_service_sts", "com_github_hashicorp_go_hclog", "com_github_hashicorp_hcl", "com_github_spiffe_go_spiffe_v2", "com_github_spiffe_spire_plugin_sdk", "com_github_uudashr_gocognit", "org_golang_google_grpc", "org_golang_google_protobuf")

# The plugin image holds the binary and nothing else, so there is no base
# image to pin (//bazel/image:defs.bzl, base = None).

# The SPIRE server release that //integration/spireserver runs this plugin
# under, as an external UpstreamAuthority. Pinned by version and by the
# SHA-256 GitHub records for each release asset.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

SPIRE_VERSION = "1.15.5"

[
    http_archive(
        name = "spire_linux_" + arch,
        build_file_content = 'exports_files(["bin/spire-server"], visibility = ["//visibility:public"])',
        sha256 = sha256,
        strip_prefix = "spire-" + SPIRE_VERSION,
        url = "https://github.com/spiffe/spire/releases/download/v{v}/spire-{v}-linux-{arch}-musl.tar.gz".format(
            arch = arch,
            v = SPIRE_VERSION,
        ),
    )
    for arch, sha256 in {
        "amd64": "f0d1740504fc95e49860ea22dcbe878ebbfee4c9bb077c6a586ed66b9c82a62e",
        "arm64": "451baba77cba6a0b2cdd3ca8b589589418b88673867d2da7f8dac9099252b372",
    }.items()
]
