load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "nogo")
load("//bazel/nogo:staticcheck.bzl", "STATICCHECK")

# gazelle:prefix github.com/bpalermo/spire-upstream-secretsmanager
#
# The protos import the protovalidate annotations: their proto_library is the
# protovalidate module's, and their Go package the buf.build/gen/go module of
# go.mod.
# gazelle:resolve proto buf/validate/validate.proto @protovalidate//proto/protovalidate/buf/validate:validate_proto
# gazelle:resolve proto go buf/validate/validate.proto @build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate
#
# The Go code of every proto is generated by Bazel (Gazelle's
# go_proto_library) and is not committed.

gazelle(name = "gazelle")

# The analyzers every Go package is compiled with (see go_sdk.nogo in
# MODULE.bazel): the ones `go vet` runs, the rest of the x/tools set that
# rules_go recommends, and staticcheck.
nogo(
    name = "nogo",
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO + STATICCHECK,
)

exports_files([
    ".shellcheckrc",
    # Its example rotator configuration is parsed by //config:config_test.
    "docs/rotator.md",
    # The release being worked towards; see bazel/workspace_status.sh.
    "VERSION",
    # The buf configuration: its lint rules (the *_proto_lint_test targets)
    # and its breaking-change rules (bazel/proto/breaking.sh).
    "buf.yaml",
])

alias(
    name = "format",
    actual = "//bazel/format",
)

alias(
    name = "format.check",
    actual = "//bazel/format:format.check",
)
