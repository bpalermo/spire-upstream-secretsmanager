load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The publishing coordinates (registry.bzl) and their reader for shell and the
# workflows (registry.sh), the git state that stamps the binaries' version and
# the image's tags (workspace_status.sh), and the signature verifier with its
# registry helpers (verify-image-signatures.sh, registry-lib.sh), which
# //bazel/cosign:verify_image runs with the pinned cosign. registry.sh parses
# registry.bzl from the checkout, not from runfiles, so the verifier takes its
# expected layout from the environment there.
exports_files([
    "check-registry-config.sh",
    "registry.bzl",
    "registry.sh",
    "registry-lib.sh",
    "verify-image-signatures.sh",
    "workspace_status.sh",
])

# For the shellcheck aspect (--config=lint): the workspace status script is
# run by Bazel itself and the rest are run by people and workflows, so no
# target would otherwise show them to the aspect.
sh_library(
    name = "scripts",
    srcs = glob(["*.sh"]),
)

# The decision of check-registry-config.sh (the `lint` job of ci.yml), on
# fixture checkouts: the setting alone passes, a literal elsewhere fails.
sh_test(
    name = "check_registry_config_test",
    size = "small",
    srcs = ["check_registry_config_test.sh"],
    data = [
        "check-registry-config.sh",
        "registry.bzl",
        "registry.sh",
    ],
)

sh_test(
    name = "workspace_status_test",
    size = "small",
    srcs = ["workspace_status_test.sh"],
    data = ["workspace_status.sh"],
)

# The decision of ci-impacted-targets.sh (the `diff` job of ci.yml): which
# impacted targets CI builds and tests, on fixture lists.
sh_test(
    name = "ci_impacted_targets_test",
    size = "small",
    srcs = ["ci_impacted_targets_test.sh"],
    data = ["ci-impacted-targets.sh"],
)
